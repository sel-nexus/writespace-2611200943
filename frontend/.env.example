# Optional: copy to .env. These non-secret demo defaults work without a file.
# Vite development bind address; use 0.0.0.0 only when external access is needed.
VITE_HOST=127.0.0.1
# Vite development port, loaded by Vite's dotenv-backed loadEnv.
VITE_PORT=5173
# Production static test server bind address (npm run preview).
HOST=127.0.0.1
# Production static test server port (npm run preview).
PORT=4173
# Playwright local server bind address when no base URL override is supplied.
PLAYWRIGHT_HOST=127.0.0.1
# Playwright production server port when no base URL override is supplied.
PLAYWRIGHT_PORT=4173
# Optional absolute origin override; when supplied, its host/port also bind webServer.
# Use a local HTTP origin: this config starts its own server, not a remote deployment.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173
# CI disables interactive retry assumptions; set true in automation.
CI=false
